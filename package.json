{
  "name": "crunch-rally",
  "private": true,
  "version": "0.1.0",
  "description": "A multiplayer snack-mascot kart racer for the browser and phones.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shots": "node scripts/screenshots.mjs",
    "build:server": "node scripts/build-server.mjs",
    "server": "node scripts/build-server.mjs && node dist-server/index.mjs",
    "ship": "node scripts/ship.mjs"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "three": "^0.187.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.12",
    "playwright-core": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
